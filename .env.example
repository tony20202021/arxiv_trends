# Conda-окружение
CONDA_ENV=conda_arxive_trends

# MongoDB — сервер (используется в start_1_db.sh)
MONGODB_BIND_HOST=127.0.0.1   # 0.0.0.0 — слушать на всех интерфейсах
MONGODB_PORT=27017

# MongoDB — клиент (используется бэкендом и ботом)
# При подключении с другой машины: MONGO_URI=mongodb://server-ip:port
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=arxiv_trends

# arXiv API
ARXIV_API_URL=https://export.arxiv.org/api/query
HTTP_USER_AGENT=arxiv-trends-bot/0.1

# Telegram бот (фронтенд)
TELEGRAM_BOT_TOKEN=
# Telegram-аккаунт для получения алертов планировщика (числовой chat_id).
# Узнать можно через @userinfobot. Если не задан — алерты не отправляются.
ALERT_TELEGRAM_CHAT_ID=

# LLM-экстрактор ключевых слов (опционально)
# Установите USE_LLM_EXTRACTOR=1 чтобы включить
USE_LLM_EXTRACTOR=0
OPENAI_LLM_URL=
OPENAI_LLM_API_KEY=
OPENAI_LLM_MODEL=

# Директория для сохранения графиков (используется ботом и веб-дашбордом)
OUTPUTS_DIR=.outputs

# Веб-дашборд (frontend/web/app.py)
WEB_HOST=127.0.0.1
WEB_PORT=8000
